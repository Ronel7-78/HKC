APP_NAME="Hot Koki"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.hotkokichaud.digital
APP_TIMEZONE=Africa/Douala
LEGAL_TERMS_VERSION=2026-11-21
EMAIL_VERIFICATION_ENABLED=true
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=hotkoki_
ADMIN_TOKEN_EXPIRATION=480

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hot_koki_production
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
CACHE_PREFIX=hot_koki_production_cache_
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_PREFIX=hot_koki_production_redis_
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@hotkokichaud.digital
MAIL_FROM_NAME="Hot Koki"

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CamPay centralise MTN MoMo et Orange Money. Ne l'activer qu'après
# validation du KYC et de l'application Live par CamPay.
PAYMENT_GATEWAY=campay

CAMPAY_ENABLED=false
CAMPAY_ENVIRONMENT=LIVE
CAMPAY_BASE_URL=https://www.campay.net
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_CURRENCY=XAF
CAMPAY_DEMO_AMOUNT=10
CAMPAY_COLLECTION_RATE=0.02
CAMPAY_WITHDRAWAL_RATE=0.01
CAMPAY_POLL_MAX_ATTEMPTS=12
