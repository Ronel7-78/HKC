APP_NAME="Hot Koki"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Africa/Douala
LEGAL_TERMS_VERSION=2026-08-20
EMAIL_VERIFICATION_ENABLED=true
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=hotkoki_
ADMIN_TOKEN_EXPIRATION=480

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hot_koki_production
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Hot Koki"

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Ces valeurs seront fournies pendant l’onboarding MTN Cameroun Go-Live.
MTN_MOMO_BASE_URL=
MTN_MOMO_TARGET_ENVIRONMENT=mtncameroon
MTN_MOMO_CURRENCY=XAF
MTN_MOMO_CALLBACK_BASE_URL=https://api.example.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_ALLOWED_IPS=
MTN_MOMO_POLL_MAX_ATTEMPTS=12

ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_ENVIRONMENT=production
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_AUTH_BASE_URL=
ORANGE_MONEY_TOKEN_PATH=/oauth/v3/token
ORANGE_MONEY_WEBPAY_PATH=
ORANGE_MONEY_WEBPAYMENT_PATH=
ORANGE_MONEY_STATUS_PATH=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CALLBACK_BASE_URL=
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_CANCEL_URL=
ORANGE_MONEY_CURRENCY=XAF
ORANGE_MONEY_LANGUAGE=fr
ORANGE_MONEY_POLL_MAX_ATTEMPTS=12
