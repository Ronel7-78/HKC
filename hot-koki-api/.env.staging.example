APP_NAME="Hot Koki Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.example.com
APP_TIMEZONE=Africa/Douala
LEGAL_TERMS_VERSION=2026-11-21
EMAIL_VERIFICATION_ENABLED=true
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=hotkoki_
ADMIN_TOKEN_EXPIRATION=480

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Adresse publique de la machine qui execute k6. Cette exception ne fonctionne
# que lorsque APP_ENV=staging ; ne jamais renseigner en production.
K6_TEST_IP=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hot_koki_staging
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
CACHE_PREFIX=hot_koki_staging_cache_
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_PREFIX=hot_koki_staging_redis_
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Hot Koki Staging"

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYMENT_GATEWAY=campay

CAMPAY_ENABLED=true
CAMPAY_ENVIRONMENT=DEV
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_CURRENCY=XAF
CAMPAY_DEMO_AMOUNT=10
CAMPAY_COLLECTION_RATE=0.02
CAMPAY_WITHDRAWAL_RATE=0.01
CAMPAY_POLL_MAX_ATTEMPTS=12
