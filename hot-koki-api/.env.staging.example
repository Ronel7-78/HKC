APP_NAME="Hot Koki Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.example.com
APP_TIMEZONE=Africa/Douala
LEGAL_TERMS_VERSION=2026-08-20
EMAIL_VERIFICATION_ENABLED=true
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=hotkoki_

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hot_koki_staging
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Hot Koki Staging"

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_CALLBACK_BASE_URL=https://staging-api.example.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_ALLOWED_IPS=
MTN_MOMO_POLL_MAX_ATTEMPTS=8

ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_ENVIRONMENT=sandbox
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_AUTH_BASE_URL=
ORANGE_MONEY_TOKEN_PATH=/oauth/v3/token
ORANGE_MONEY_WEBPAY_PATH=/orange-money-webpay/dev/v1
ORANGE_MONEY_WEBPAYMENT_PATH=/webpayment
ORANGE_MONEY_STATUS_PATH=/transactionstatus
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CALLBACK_BASE_URL=
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_CANCEL_URL=
ORANGE_MONEY_CURRENCY=XAF
ORANGE_MONEY_LANGUAGE=fr
ORANGE_MONEY_POLL_MAX_ATTEMPTS=8
