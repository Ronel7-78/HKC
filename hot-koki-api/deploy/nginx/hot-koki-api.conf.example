server {
    listen 443 ssl http2;
    server_name api.example.com;

    # Ne jamais utiliser la racine du dépôt comme racine web.
    root /var/www/hot-koki-api/public;
    index index.php;
    client_max_body_size 6m;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Bloque les fichiers cachés, sauf le répertoire ACME de Let's Encrypt.
    location ~ /\.(?!well-known).* {
        deny all;
        return 404;
    }

    # Bloque les sauvegardes, dumps, clés et configurations accidentelles.
    location ~* \.(?:bak|config|ini|log|pem|key|p12|sql|sqlite)$ {
        deny all;
        return 404;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }
}
