APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Douala
LEGAL_TERMS_VERSION=2026-08-20
EMAIL_VERIFICATION_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hotkoki.cm"
MAIL_FROM_NAME="Hot Koki Chaud"

DELIVERY_FREE_RADIUS_KM=3
DELIVERY_FLAT_FEE_XAF=500

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MTN MoMo Collections Sandbox
# Copiez ce modèle vers .env puis renseignez les valeurs sur la machine locale.
# Le fichier .env réel est ignoré par Git et ne doit jamais être partagé.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_CALLBACK_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_ALLOWED_IPS=
MTN_MOMO_POLL_MAX_ATTEMPTS=8

# Orange Money Web Payment — sandbox. Les chemins peuvent être remplacés
# par ceux remis par Orange Cameroun sans modifier le code.
ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_ENVIRONMENT=sandbox
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_AUTH_BASE_URL=https://api.orange.com
ORANGE_MONEY_TOKEN_PATH=/oauth/v3/token
ORANGE_MONEY_WEBPAY_PATH=/orange-money-webpay/dev/v1
ORANGE_MONEY_WEBPAYMENT_PATH=/webpayment
ORANGE_MONEY_STATUS_PATH=/transactionstatus
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CALLBACK_BASE_URL=
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_CANCEL_URL=
ORANGE_MONEY_CURRENCY=OUV
ORANGE_MONEY_LANGUAGE=fr
ORANGE_MONEY_POLL_MAX_ATTEMPTS=8
